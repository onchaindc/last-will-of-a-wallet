{
  "name": "last-will-of-a-wallet",
  "version": "2.0.0",
  "private": true,
  "description": "A crypto inheritance kit built with @hyper-elements/react: a printable letter of instruction (PDF), a calm walkthrough page for heirs, a check-in email and an heir notice email, all from one validated data object.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs",
    "test": "tsx test/validate.test.ts",
    "build": "tsx src/build.tsx",
    "check": "tsc --noEmit",
    "all": "npm test && npm run build"
  },
  "dependencies": {
    "@hyper-elements/react": "^0.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.2.5",
    "@fontsource/source-serif-4": "^5.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
